# Copy to client/.env.local (gitignored). Only VITE_* values reach the browser,
# so never put secrets here.

# true  = use the in-memory mock API (src/services/mocks), no backend needed
# false = call the real backend
VITE_USE_MOCKS=true

# Base path for API calls. Keep /api in dev: Vite proxies it to the backend.
VITE_API_BASE_URL=/api

# Where the Vite dev proxy forwards /api (dev server only)
VITE_API_PROXY_TARGET=http://localhost:5000

# Fake network delay for mock responses, in ms
VITE_MOCK_LATENCY_MS=400
