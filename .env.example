# Copy this file to server/.env and fill in the values.
# Never commit server/.env.

# --- Server ---
PORT=5000
NODE_ENV=development
# Frontend origin allowed by CORS (Vite default)
CLIENT_ORIGIN=http://localhost:5173

# --- MongoDB (shared by the Backend and the AI module) ---
MONGODB_URI=
MONGODB_DB_NAME=bayyinah

# --- Auth ---
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- AI module (server-side only) ---
GEMINI_API_KEY=
VOYAGE_API_KEY=
# Optional overrides
GEMINI_MODEL=
VOYAGE_EMBEDDING_MODEL=
