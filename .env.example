# Copy this file to server/.env and fill in the values.
# Never commit server/.env.

# --- Server ---
PORT=5000
NODE_ENV=development
# Frontend origin(s) allowed by CORS, comma separated (add the deployed URL)
CLIENT_ORIGIN=http://localhost:5173

# --- MongoDB (shared by the Backend and the AI module) ---
# MongoDB Atlas → Connect → Drivers → copy the mongodb+srv://… string (see README "Keys and secrets").
MONGODB_URI=
MONGODB_DB_NAME=bayyinah

# Behind a proxy (Render) set 1 so rate limits use the real client address.
# Defaults to 1 when NODE_ENV=production, otherwise off.
TRUST_PROXY=
# Rate limits (defaults: 30 sign-ins / 15 min and 20 accounts / hour per IP, 20 questions / hour per account)
RATE_LOGIN_MAX=
RATE_REGISTER_MAX=
RATE_QUESTIONS_MAX=

# --- Auth ---
# Required in production. Use a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Password of the seeded dāʿī/admin accounts (npm run seed). Required in production.
SEED_PASSWORD=

# --- AI module (server-side only) ---
# real = use modules/ai, mock = canned results (no keys needed).
# Leave empty: real when the keys below exist, otherwise mock.
AI_MODE=
AI_TIMEOUT_MS=90000
# openai (default, https://platform.openai.com/api-keys) or gemini (https://aistudio.google.com/apikey)
LLM_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
# Voyage AI by MongoDB: Atlas → Services → AI Model APIs → Model API Keys
VOYAGE_API_KEY=
# Optional; default voyage-4-large (must match the model the knowledge base was embedded with)
VOYAGE_EMBEDDING_MODEL=
# Only for AI_MODE=mock: simulated processing time in milliseconds
MOCK_AI_DELAY_MS=1500

# --- Live tests only (real MongoDB and model APIs; cost credit). See docs/testing.md ---
# The npm scripts set RUN_LIVE_* themselves; set these only to run a test file directly.
RUN_LIVE_AI_TESTS=
SAHEEH_TRANSLATION_SOURCE_URL=https://quranpedia.net/
SAHEEH_TRANSLATION_SOURCE_VERSION=
