{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "seed": "node ../scripts/seed-db.js",
    "test:backend": "node --test tests/api.test.js",
    "test:ai": "node --test src/modules/ai/classifier/questionClassifier.test.js src/modules/ai/providers/openaiLLMProvider.test.js src/modules/ai/orchestrator/providerFailure.test.js src/modules/ai/orchestrator/languageAndRequirements.test.js src/modules/ai/orchestrator/retrievalFilters.test.js src/modules/ai/rag/retrieval/vectorRetriever.requiredSources.test.js src/modules/ai/rag/citation/citationBuilder.test.js src/modules/ai/rag/ingestion/ingestionPipeline.test.js src/modules/ai/rag/ingestion/quran/quranChunkBuilder.test.js src/modules/ai/rag/ingestion/quran/quranParser.test.js src/modules/ai/rag/ingestion/sourceContract.test.js src/modules/ai/rag/ingestion/translations/saheehInternationalParser.test.js src/modules/ai/rag/ingestion/translations/saheehInternationalChunkBuilder.test.js src/modules/ai/rag/ingestion/tafsir/tafsirParser.test.js src/modules/ai/rag/ingestion/tafsir/tafsirIngestion.test.js src/modules/ai/rag/ingestion/hadith/hadithParser.test.js src/modules/ai/rag/ingestion/hadith/hadithIngestion.test.js src/modules/ai/rag/retrieval/vectorRetriever.filter.test.js src/modules/ai/rag/storage/vectorIndex.behavior.test.js src/modules/ai/verifier/claimLevelVerification.test.js src/modules/ai/generator/draftGenerator.test.js",
    "test": "npm run test:backend",
    "test:language-aware": "node src/modules/ai/classifier/questionClassifier.test.js && node --test src/modules/ai/orchestrator/languageAndRequirements.test.js src/modules/ai/rag/retrieval/vectorRetriever.requiredSources.test.js",
    "test:translation-workflow": "RUN_LIVE_AI_TESTS=1 node --test tests/saheehInternationalWorkflow.test.js",
    "test:tafsir-workflow": "RUN_LIVE_TAFSIR_TESTS=1 node --test tests/tafsirWorkflow.test.js",
    "validate:knowledge-sources:e2e": "RUN_LIVE_KNOWLEDGE_E2E=1 node tests/knowledgeSourcesE2E.validation.js",
    "validate:knowledge-sources:tafsir": "RUN_LIVE_KNOWLEDGE_E2E=1 KNOWLEDGE_E2E_CASE=tafsir_en node tests/knowledgeSourcesE2E.validation.js",
    "validate:knowledge-sources:remaining": "RUN_LIVE_KNOWLEDGE_E2E=1 KNOWLEDGE_E2E_CASE=multi_source_ar,multi_source_en,unrelated_python,personal_ruling_ar node tests/knowledgeSourcesE2E.validation.js",
    "validate:knowledge-sources:arabic-explanations": "RUN_LIVE_KNOWLEDGE_E2E=1 KNOWLEDGE_E2E_CASE=tafsir_ar,multi_source_ar node tests/knowledgeSourcesE2E.validation.js",
    "ingest:hadith:dry-run": "node src/modules/ai/rag/ingestion/hadith/hadithFullIngestion.js --dry-run",
    "test:hadith-workflow": "RUN_LIVE_HADITH_TESTS=1 node --test tests/hadithWorkflow.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@google/genai": "^2.26.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.7.0",
    "mongoose": "^9.10.3",
    "openai": "^7.27.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
